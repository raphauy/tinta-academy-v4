generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  image     String?
  role      Role?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  otpTokens       OtpToken[]
  student         Student?
  educator        Educator?
  orders          Order[]   @relation("UserOrders")
  cancelledOrders Order[]   @relation("CancelledOrders")

  @@index([email])
  @@index([isActive])
}

model OtpToken {
  id        String    @id @default(cuid())
  token     String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// ============================================
// STUDENT
// ============================================

model Student {
  id               String    @id @default(cuid())
  userId           String    @unique
  firstName        String?
  lastName         String?
  identityDocument String?   // CI (Cédula de Identidad)
  dateOfBirth      DateTime?
  phone            String?
  address          String?
  city             String?
  zip              String?
  country          String?
  // Billing information
  billingName    String? // Nombre o razón social
  billingTaxId   String? // RUT/CI
  billingAddress String? // Dirección de facturación
  // Notification preferences
  notifyNewCourses    Boolean @default(true)
  notifyPromotions    Boolean @default(false)
  notifyCourseUpdates Boolean @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  orders      Order[]

  // Email communications relations
  emailRecipients    EmailRecipient[]
  workflowExecutions WorkflowExecution[]

  @@index([userId])
}

// ============================================
// EDUCATOR
// ============================================

model Educator {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  title     String?
  bio       String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses Course[]

  // Email communications relations
  emailTemplates    EmailTemplate[]
  emailCampaigns    EmailCampaign[]
  workflowTemplates WorkflowTemplate[]
  audienceFilters   AudienceFilter[]

  @@index([userId])
}

// ============================================
// COURSES & TAGS
// ============================================

model Tag {
  id      String   @id @default(cuid())
  name    String
  slug    String   @unique
  courses Course[]

  @@index([slug])
}

model Course {
  id                   String          @id @default(cuid())
  slug                 String          @unique
  title                String
  type                 CourseType
  modality             CourseModality
  description          String?
  startDate            DateTime?
  endDate              DateTime?
  duration             String?
  // Class schedule fields
  classDates           DateTime[]
  startTime            String?         // e.g. "17:00"
  classDuration        Int?            // duration per class in minutes
  examDate             DateTime?
  registrationDeadline DateTime?
  // Capacity and pricing
  maxCapacity          Int?
  enrolledCount        Int             @default(0)
  priceUSD             Float
  priceUYU             Float? // price in Uruguayan pesos for MercadoPago
  location             String?
  address              String?
  imageUrl             String?
  status               CourseStatus
  educatorId           String
  wsetLevel            Int?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  educator    Educator         @relation(fields: [educatorId], references: [id])
  tags        Tag[]
  enrollments Enrollment[]
  materials   CourseMaterial[]
  orders      Order[]
  coupons     Coupon[] // coupons restricted to this course

  // Email communications relations
  emailCampaigns  EmailCampaign[]
  courseWorkflows CourseWorkflow[]

  @@index([slug])
  @@index([educatorId])
  @@index([status])
  @@index([type])
  @@index([modality])
}

// ============================================
// COURSE MATERIALS
// ============================================

model CourseMaterial {
  id          String       @id @default(cuid())
  courseId    String
  name        String
  type        MaterialType
  url         String
  description String?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([order])
}

// ============================================
// NEWSLETTER
// ============================================

model NewsletterSubscription {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  isActive     Boolean  @default(true)

  @@index([email])
  @@index([isActive])
}

// ============================================
// ENROLLMENT
// ============================================

model Enrollment {
  id         String           @id @default(cuid())
  studentId  String
  courseId   String
  enrolledAt DateTime         @default(now())
  status     EnrollmentStatus @default(pending)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Email communications relations
  workflowExecutions WorkflowExecution[]

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@index([status])
}

// ============================================
// BANK ACCOUNTS
// ============================================

model BankAccount {
  id            String   @id @default(cuid())
  bankName      String
  accountHolder String // titular de la cuenta
  accountType   String // Caja de ahorro, Cuenta corriente, etc
  accountNumber String
  currency      Currency
  swiftCode     String? // for international transfers
  routingNumber String?
  displayOrder  Int      @default(0)
  notes         String? // internal notes
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]

  @@index([currency])
  @@index([isActive])
}

// ============================================
// COUPONS
// ============================================

model Coupon {
  id                   String    @id @default(cuid())
  code                 String    @unique
  discountPercent      Float // 0-100
  maxUses              Int       @default(1)
  currentUses          Int       @default(0)
  restrictedToEmail    String? // if set, only this email can use
  restrictedToCourseId String? // if set, only for this course
  minPurchaseAmount    Float? // minimum purchase amount
  validFrom            DateTime  @default(now())
  expiresAt            DateTime?
  isActive             Boolean   @default(true)
  description          String? // internal description
  createdBy            String? // admin user ID
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  orders           Order[]
  restrictedCourse Course? @relation(fields: [restrictedToCourseId], references: [id])

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
  @@index([restrictedToEmail])
}

// ============================================
// ORDERS
// ============================================

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique // format: TA-YYYYMMDD-XXXX
  userId            String
  courseId          String
  studentId         String? // linked after payment confirmed
  couponId          String? // linked to Coupon (added in 6.03)
  // Pricing
  originalPriceUSD  Float
  originalPriceUYU  Float?
  discountPercent   Float         @default(0)
  discountAmount    Float         @default(0)
  finalAmount       Float
  currency          Currency      @default(USD)
  // Payment
  paymentMethod     PaymentMethod
  status            OrderStatus   @default(created)
  // MercadoPago fields
  mpPreferenceId    String? // MercadoPago preference ID
  mpPaymentId       String? // MercadoPago payment ID
  mpStatus          String? // MercadoPago status
  mpStatusDetail    String? // MercadoPago status detail
  // Bank transfer fields
  bankAccountId     String? // linked to BankAccount (added in 6.02)
  transferReference String? // user reference/comment
  transferProofUrl  String? // URL of uploaded transfer proof (image/pdf)
  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  paidAt            DateTime?
  cancelledAt       DateTime?
  cancelledById     String?       // user who cancelled the order
  refundedAt        DateTime?

  // Relations
  user        User         @relation("UserOrders", fields: [userId], references: [id])
  course      Course       @relation(fields: [courseId], references: [id])
  student     Student?     @relation(fields: [studentId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])
  coupon      Coupon?      @relation(fields: [couponId], references: [id])
  cancelledBy User?        @relation("CancelledOrders", fields: [cancelledById], references: [id])

  @@index([userId])
  @@index([courseId])
  @@index([status])
  @@index([paymentMethod])
  @@index([orderNumber])
  @@index([mpPreferenceId])
  @@index([mpPaymentId])
}

// ============================================
// ENUMS
// ============================================

enum Role {
  superadmin
  educator
  student
}

enum CourseType {
  wset
  taller
  cata
  curso
}

enum CourseModality {
  presencial
  online
}

enum CourseStatus {
  draft
  announced
  enrolling
  full
  in_progress
  finished
  available
}

enum EnrollmentStatus {
  pending
  confirmed
  cancelled
}

enum MaterialType {
  link
  image
  document
  video
  other
}

enum OrderStatus {
  created
  pending_payment
  payment_processing
  paid
  cancelled
  refunded
  rejected
}

enum PaymentMethod {
  mercadopago
  bank_transfer
  free
}

enum Currency {
  USD
  UYU
}

// ============================================
// EMAIL COMMUNICATIONS ENUMS
// ============================================

enum EmailCampaignStatus {
  draft
  scheduled
  sending
  sent
  partially_sent
  cancelled
}

enum EmailDeliveryStatus {
  pending
  sending
  sent
  delivered
  opened
  clicked
  bounced
  failed
}

enum WorkflowTriggerType {
  course_start
  course_end
  exam_date
  class_date
  registration_deadline
}

enum CourseWorkflowStatus {
  active
  paused
  completed
}

// ============================================
// EMAIL TEMPLATES
// ============================================

model EmailTemplate {
  id         String   @id @default(cuid())
  name       String
  subject    String
  body       String   @db.Text

  educatorId String
  educator   Educator @relation(fields: [educatorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns     EmailCampaign[]
  workflowSteps WorkflowStep[]

  @@index([educatorId])
}

// ============================================
// EMAIL CAMPAIGNS (manual sends)
// ============================================

model EmailCampaign {
  id         String   @id @default(cuid())
  name       String

  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id])

  educatorId String
  educator   Educator @relation(fields: [educatorId], references: [id])

  courseId String?
  course   Course?  @relation(fields: [courseId], references: [id])

  audienceFilterId String?
  audienceFilter   AudienceFilter? @relation(fields: [audienceFilterId], references: [id])

  scheduledAt DateTime?
  timezone    String

  status EmailCampaignStatus @default(draft)

  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  deliveredCount  Int @default(0)
  openedCount     Int @default(0)
  clickedCount    Int @default(0)
  failedCount     Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sentAt    DateTime?

  recipients EmailRecipient[]

  @@index([educatorId])
  @@index([courseId])
  @@index([audienceFilterId])
  @@index([status])
  @@index([scheduledAt])
}

model EmailRecipient {
  id String @id @default(cuid())

  campaignId String
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  email String

  status EmailDeliveryStatus @default(pending)

  resendId    String?
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, studentId])
  @@index([campaignId])
  @@index([studentId])
  @@index([status])
  @@index([resendId])
}

// ============================================
// WORKFLOWS (automation)
// ============================================

model WorkflowTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?

  educatorId String
  educator   Educator @relation(fields: [educatorId], references: [id])

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps           WorkflowStep[]
  courseWorkflows CourseWorkflow[]

  @@index([educatorId])
  @@index([isActive])
}

model WorkflowStep {
  id String @id @default(cuid())

  workflowTemplateId String
  workflowTemplate   WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)

  templateId String
  template   EmailTemplate @relation(fields: [templateId], references: [id])

  triggerType       WorkflowTriggerType
  triggerOffset     Int
  triggerClassIndex Int?

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions WorkflowExecution[]

  @@index([workflowTemplateId])
  @@index([templateId])
}

model CourseWorkflow {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  workflowTemplateId String
  workflowTemplate   WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id])

  status CourseWorkflowStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions WorkflowExecution[]

  @@unique([courseId, workflowTemplateId])
  @@index([courseId])
  @@index([workflowTemplateId])
  @@index([status])
}

model WorkflowExecution {
  id String @id @default(cuid())

  courseWorkflowId String
  courseWorkflow   CourseWorkflow @relation(fields: [courseWorkflowId], references: [id], onDelete: Cascade)

  workflowStepId String
  workflowStep   WorkflowStep @relation(fields: [workflowStepId], references: [id])

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])

  email String

  scheduledAt DateTime

  status EmailDeliveryStatus @default(pending)

  resendId    String?
  sentAt      DateTime?
  deliveredAt DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseWorkflowId, workflowStepId, studentId])
  @@index([courseWorkflowId])
  @@index([workflowStepId])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([scheduledAt])
  @@index([status])
  @@index([resendId])
}

// ============================================
// AUDIENCE FILTERS
// ============================================

model AudienceFilter {
  id          String   @id @default(cuid())
  name        String
  description String?

  educatorId  String
  educator    Educator @relation(fields: [educatorId], references: [id])

  isPublic    Boolean  @default(false)

  // Conditions serialized as JSON
  conditions  String   @db.Text

  // Cache for student count
  cachedStudentCount Int?
  cachedAt           DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns   EmailCampaign[]

  @@index([educatorId])
  @@index([isPublic])
}
